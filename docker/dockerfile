# ---- Build stage: install deps into a venv, discarded afterwards ----
# (every dependency ships a prebuilt wheel for this image, so no compiler
# toolchain is needed here; add build-essential if a future dependency
# needs one)
FROM python:3.11-slim AS builder

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY}

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ---- Runtime stage: just the venv + app code, no compilers, no proxy env ----
FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

COPY iri_api.py .

RUN useradd --system --create-home appuser
USER appuser

EXPOSE 8000
CMD ["uvicorn", "iri_api:app", "--host", "0.0.0.0", "--port", "8000"]

# ---- Build stage: install deps into a venv, discarded afterwards ----
# (every dependency ships a prebuilt wheel for this image, so no compiler
# toolchain is needed here; add build-essential if a future dependency
# needs one)
FROM python:3.14-slim AS builder

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY}

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ---- Runtime stage: just the venv + app code, no compilers, no proxy env ----
FROM python:3.14-slim

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

COPY iri_api.py bert_models.py keyword_extraction.py stop_words.py LICENSE NOTICE ./

# Create the Hugging Face cache owned by appuser: a named volume mounted there
# (to keep downloaded models across restarts) takes its ownership from the image
# when first created; without this Docker creates the mount point as root and
# the model download fails with a PermissionError.
RUN useradd --system --create-home appuser && \
    mkdir -p /home/appuser/.cache/huggingface && \
    chown -R appuser:appuser /home/appuser/.cache
USER appuser

EXPOSE 8000
CMD ["uvicorn", "iri_api:app", "--host", "0.0.0.0", "--port", "8000"]
